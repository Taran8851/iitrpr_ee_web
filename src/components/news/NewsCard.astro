---
/** News list item: calendar-style date block, category badge, title, description, optional thumbnail (GLightbox). */
import { Icon } from "astro-icon/components";
import { category } from "./categories";

interface Props {
  title: string;
  description: string;
  date: string; // YYYY-MM-DD
  image?: string;
  category: string;
}
const { title, description, date, image, category: cat } = Astro.props;
const [year, month, day] = date.split("-");
const monthName = new Date(Date.UTC(+year, +month - 1, +day)).toLocaleString("en", { month: "short", timeZone: "UTC" });
const c = category(cat);
---
<article
  data-filter-item
  data-group={year}
  data-text={`${title} ${description} ${c.label} ${date}`}
  class="card card-border border-base-content/10 bg-base-100 transition hover:border-primary/40 hover:shadow-lg hover:shadow-primary/5"
>
  <div class="card-body flex-row gap-4 p-4 sm:gap-5 sm:p-5">
    <time
      datetime={date}
      class="flex w-16 shrink-0 flex-col items-center self-start overflow-hidden rounded-xl border border-base-content/10 text-center sm:w-20"
    >
      <span class="w-full bg-primary py-0.5 text-[0.7rem] font-semibold uppercase tracking-wider text-primary-content">{monthName}</span>
      <span class="font-display text-2xl font-bold leading-tight sm:text-3xl">{day}</span>
      <span class="pb-1 text-xs text-base-content/60">{year}</span>
    </time>
    <div class="min-w-0 flex-1">
      <span class="badge badge-sm badge-soft badge-secondary mb-2 gap-1">
        <Icon name={c.icon} class="size-3" />{c.label}
      </span>
      <h2 class="font-display text-lg font-semibold leading-snug">{title}</h2>
      <p class="mt-1 text-sm text-base-content/70">{description}</p>
    </div>
    {image && (
      <a href={image} class="glightbox hidden shrink-0 sm:block" data-gallery="news" data-title={title} aria-label={`View image: ${title}`}>
        <img src={image} alt="" loading="lazy" class="size-24 rounded-xl object-cover md:size-28" />
      </a>
    )}
  </div>
</article>
