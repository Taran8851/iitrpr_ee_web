---
import { Icon } from "astro-icon/components";
import PagefindConfig from "astro-pagefind/components/PagefindConfig.astro";
import { mainNav } from "../../lib/nav";

interface Props {
  /** Transparent over a dark hero until scrolled (home page). */
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => path === href || path.startsWith(href + "/");
---

<header
  data-site-header
  data-overlay={overlay ? "" : undefined}
  class:list={[
    "group/header sticky top-0 z-50 w-full transition-colors duration-300",
    overlay ? "-mb-[4.5rem]" : "",
  ]}
>
  <div
    class:list={[
      "border-b transition-all duration-300",
      "border-base-content/10 glass",
      overlay &&
        "group-[:not([data-scrolled])]/header:border-transparent group-[:not([data-scrolled])]/header:bg-transparent group-[:not([data-scrolled])]/header:backdrop-blur-none group-[:not([data-scrolled])]/header:text-white",
    ]}
  >
    <nav class="navbar mx-auto h-[4.5rem] max-w-7xl px-4" aria-label="Main">
      <div class="navbar-start gap-3">
        <a href="/" class="flex items-center gap-3" aria-label="EE IIT Ropar home">
          <img src="/assets/logo_0_1.png" alt="" class="h-10 w-10 object-contain" width="40" height="40" />
          <span class="leading-tight">
            <span class="block font-display text-base font-bold">Electrical Engineering</span>
            <span class="block text-xs opacity-70">IIT Ropar</span>
          </span>
        </a>
      </div>

      <div class="navbar-center hidden lg:flex">
        <ul class="flex items-center gap-1 text-sm font-medium">
          {
            mainNav.map((item) =>
              "children" in item ? (
                <li class="group/dd relative" data-nav-dd>
                  <button
                    type="button"
                    data-nav-link
                    aria-haspopup="true"
                    class:list={[
                      "flex items-center gap-1 rounded-lg px-3 py-2 transition-colors hover:bg-base-content/5",
                      item.children.some((c) => isActive(c.href)) && "text-primary",
                    ]}
                  >
                    {item.label}
                    <Icon name="lucide:chevron-down" class="size-4 opacity-60 transition-transform duration-300 group-hover/dd:rotate-180 group-focus-within/dd:rotate-180" />
                  </button>
                  <div class="invisible absolute left-1/2 top-full z-20 -translate-x-1/2 translate-y-2 pt-3 opacity-0 transition-all duration-200 group-hover/dd:visible group-hover/dd:translate-y-0 group-hover/dd:opacity-100 group-focus-within/dd:visible group-focus-within/dd:translate-y-0 group-focus-within/dd:opacity-100">
                    <ul
                      class:list={[
                        "glass grid gap-1 rounded-2xl p-2 text-base-content shadow-2xl shadow-black/20",
                        item.children.length > 3 ? "w-[34rem] grid-cols-2" : "w-80",
                      ]}
                    >
                      {item.children.map((c) => (
                        <li>
                          <a
                            href={c.href}
                            class:list={[
                              "group/item flex items-start gap-3 rounded-xl p-3 transition-colors hover:bg-primary/10",
                              isActive(c.href) && "bg-primary/10",
                            ]}
                          >
                            {c.icon && (
                              <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-primary/15 text-primary transition-transform duration-300 group-hover/item:scale-110 group-hover/item:-rotate-6">
                                <Icon name={c.icon} class="size-5" />
                              </span>
                            )}
                            <span>
                              <span class="block font-semibold">{c.label}</span>
                              {c.desc && <span class="block text-xs font-normal text-base-content/60">{c.desc}</span>}
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </li>
              ) : (
                <li>
                  <a
                    href={item.href}
                    data-nav-link
                    class:list={["block rounded-lg px-3 py-2 transition-colors hover:bg-base-content/5", isActive(item.href) && "text-primary"]}
                  >
                    {item.label}
                  </a>
                </li>
              ),
            )
          }
        </ul>
      </div>

      <div class="navbar-end gap-1">
        <!-- Site search (Pagefind): button + Ctrl/⌘K opens the modal. Index is built by `astro build`. -->
        <PagefindConfig />
        <pagefind-modal-trigger class="hidden sm:block"></pagefind-modal-trigger>
        <button class="btn btn-ghost btn-circle sm:hidden" data-search-open aria-label="Search">
          <Icon name="lucide:search" class="size-5" />
        </button>
        <button class="btn btn-ghost btn-circle" data-theme-toggle aria-label="Toggle dark mode">
          <Icon name="lucide:sun" class="hidden size-5 [[data-theme=voltage-dark]_&]:block" />
          <Icon name="lucide:moon" class="size-5 [[data-theme=voltage-dark]_&]:hidden" />
        </button>
        <label for="nav-drawer" class="btn btn-ghost btn-circle lg:hidden" aria-label="Open menu">
          <Icon name="lucide:menu" class="size-6" />
        </label>
      </div>
    </nav>
  </div>
</header>

<pagefind-modal></pagefind-modal>
<script>
  // Escape closes an open mega-menu (focus-within) and returns focus to its button.
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    const dd = (document.activeElement as HTMLElement | null)?.closest<HTMLElement>("[data-nav-dd]");
    if (dd) {
      dd.querySelector<HTMLElement>("button")?.focus();
      (document.activeElement as HTMLElement).blur();
    }
  });
  // Mobile search icon opens the same Pagefind modal.
  document.querySelector("[data-search-open]")?.addEventListener("click", () => {
    (document.querySelector("pagefind-modal") as (HTMLElement & { open?: () => void }) | null)?.open?.();
  });
</script>

<!-- Mobile drawer (glass) -->
<div class="drawer drawer-end lg:hidden">
  <input id="nav-drawer" type="checkbox" class="drawer-toggle" />
  <div class="drawer-side z-[60]">
    <label for="nav-drawer" aria-label="Close menu" class="drawer-overlay"></label>
    <div class="glass min-h-full w-80 p-4">
      <div class="mb-4 flex items-center justify-between">
        <span class="font-display text-lg font-bold">Menu</span>
        <label for="nav-drawer" class="btn btn-ghost btn-circle btn-sm" aria-label="Close menu">
          <Icon name="lucide:x" class="size-5" />
        </label>
      </div>
      <ul class="menu w-full p-0">
        <li><a href="/">Home</a></li>
        {
          mainNav.map((item) =>
            "children" in item ? (
              <li>
                <details open={item.children.some((c) => isActive(c.href))}>
                  <summary>{item.label}</summary>
                  <ul>
                    {item.children.map((c) => (
                      <li>
                        <a href={c.href} class:list={[isActive(c.href) && "menu-active"]}>
                          {c.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ) : (
              <li>
                <a href={item.href} class:list={[isActive(item.href) && "menu-active"]}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </div>
  </div>
</div>
