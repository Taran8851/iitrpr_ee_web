---
/** Header line of a course card: code badge, title, type badge, L-T-P-S-C, semester. */
import type { Course } from "./types";
interface Props { course: Course }
const { course: c } = Astro.props;
const elective = c.type === "elective";
---
<div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-4">
  <span class="badge badge-outline badge-primary w-fit shrink-0 font-mono text-xs font-semibold">{c.code}</span>
  <span class="grow font-medium leading-snug">{c.title}</span>
  <span class="flex shrink-0 flex-wrap items-center gap-2 text-xs">
    <span class:list={["badge badge-sm capitalize", elective ? "badge-secondary badge-soft" : "badge-accent badge-soft"]}>{c.type}</span>
    {c.ltpsc && (
      <span class="font-mono text-base-content/70" title="Lecture-Tutorial-Practical-Self study-Credits">
        <span class="sr-only">L-T-P-S-C: </span>{c.ltpsc}
      </span>
    )}
    {c.semester && <span class="badge badge-ghost badge-sm">Sem {c.semester}</span>}
  </span>
</div>
