---
/** One course as a filterable card. Expandable (daisyUI collapse) only when it has a description. */
import CourseRow from "./CourseRow.astro";
import type { Course } from "./types";
interface Props { course: Course; category: string }
const { course: c, category } = Astro.props;
const attrs = {
  "data-filter-item": "",
  "data-text": [c.code, c.title, c.type, c.description].filter(Boolean).join(" "),
  "data-group": c.type,
  "data-category": category,
};
---
{c.description ? (
  <details
    {...attrs}
    class="collapse collapse-arrow rounded-xl border border-base-content/10 bg-base-100 transition hover:border-primary/40"
  >
    <summary class="collapse-title py-3 pe-12 ps-4">
      <CourseRow course={c} />
    </summary>
    <div class="collapse-content px-4 text-sm text-base-content/75">
      <p>{c.description}</p>
    </div>
  </details>
) : (
  <div {...attrs} class="rounded-xl border border-base-content/10 bg-base-100 px-4 py-3 transition hover:border-primary/40">
    <CourseRow course={c} />
  </div>
)}
