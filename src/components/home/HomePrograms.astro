---
/** Programmes: dark navy band, glass cards; horizontal scroll-snap carousel on mobile, 4-col grid on desktop. */
import { Icon } from "astro-icon/components";
import CircuitBg from "../ui/CircuitBg.astro";

interface Program { short: string; title: string; blurb: string; icon: string }
interface Props { programs: Program[] }
const { programs } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-[#020617] py-16 text-white md:py-20" aria-labelledby="programs-heading">
  <CircuitBg class="text-amber-300 opacity-[0.05]" animated />
  <div aria-hidden="true" class="absolute -top-32 left-1/3 -z-10 size-96 rounded-full bg-amber-500/15 blur-[120px]"></div>
  <div aria-hidden="true" class="absolute -bottom-32 right-10 -z-10 size-96 rounded-full bg-cyan-500/15 blur-[120px]"></div>
  <div class="mx-auto max-w-7xl px-4">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4" data-aos="fade-up">
      <div class="max-w-3xl">
        <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-amber-400">Academics</p>
        <h2 id="programs-heading" class="text-3xl font-bold md:text-4xl">Programmes offered</h2>
        <p class="mt-3 text-white/70">From undergraduate foundations to doctoral research in specialised avenues of Electrical Engineering.</p>
      </div>
      <a href="/course" class="btn btn-primary btn-sm gap-1">Browse courses <Icon name="lucide:arrow-right" class="size-4" /></a>
    </div>

    <div class="-mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-4 lg:mx-0 lg:grid lg:grid-cols-4 lg:overflow-visible lg:px-0 lg:pb-0" tabindex="0" aria-label="Programmes">
      {programs.map((p, i) => (
        <article
          data-aos="fade-up"
          data-aos-delay={String(i * 80)}
          class="glass-dark group flex w-[82%] shrink-0 snap-start flex-col rounded-2xl p-6 transition duration-300 hover:-translate-y-1 hover:border-amber-400/40 sm:w-[46%] lg:w-auto"
        >
          <div class="flex items-center justify-between">
            <span class="inline-flex size-11 items-center justify-center rounded-xl bg-amber-400/15 text-amber-300">
              <Icon name={p.icon} class="size-6" />
            </span>
            <span class="font-display text-3xl font-bold text-white/15 transition group-hover:text-amber-300/40">{p.short}</span>
          </div>
          <h3 class="mt-6 text-xl font-bold">{p.title}</h3>
          <p class="mt-2 flex-1 text-sm text-white/75">{p.blurb}</p>
          <div class="mt-6 flex flex-wrap gap-2">
            <a href="/course" class="btn btn-sm btn-ghost border-white/20 text-white hover:bg-white/10">Courses<span class="sr-only"> — {p.title}</span></a>
            <a href="/addmissions" class="btn btn-sm btn-primary">Admissions<span class="sr-only"> — {p.title}</span></a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
