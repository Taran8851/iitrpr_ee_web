---
/** Masonry gallery of campus / event photos opened in GLightbox (wired by site.ts via `.glightbox`). */
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";

interface Photo { src: string; title: string }
interface Props { photos: Photo[] }
const { photos } = Astro.props;
---

<Section id="gallery">
  <SectionHeading eyebrow="Gallery" title="Life at EE, IIT Ropar" lead="Campus, events and milestones from the department." />
  <div class="columns-2 gap-3 md:columns-3 lg:columns-4 [&>a]:mb-3">
    {photos.map((p) => (
      <a
        href={p.src}
        class="glightbox group relative block overflow-hidden rounded-xl break-inside-avoid"
        data-gallery="home"
        data-title={p.title}
        aria-label={`Open photo: ${p.title}`}
      >
        <img src={p.src} alt={p.title} loading="lazy" class="w-full object-cover transition duration-500 group-hover:scale-105" />
        <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#020617]/70 to-transparent opacity-0 transition group-hover:opacity-100"></span>
      </a>
    ))}
  </div>
</Section>
