---
/** Featured Head-of-Department card: large photo, credentials, research focus, contact. */
import { Icon } from "astro-icon/components";
import { facultyLinks, type Faculty } from "./links";

interface Props { hod: Faculty }
const { hod } = Astro.props;
const links = facultyLinks(hod);
---
<article
  class="card relative overflow-hidden rounded-3xl border border-base-content/10 bg-base-100 shadow-xl shadow-primary/5 md:card-side"
  data-aos="fade-up"
>
  <figure class="relative isolate bg-[#0b1629] md:w-80 md:shrink-0">
    <div aria-hidden="true" class="absolute -left-10 -top-10 -z-10 size-56 rounded-full bg-amber-500/30 blur-[80px]"></div>
    <div aria-hidden="true" class="absolute -bottom-10 -right-10 -z-10 size-56 rounded-full bg-cyan-500/25 blur-[80px]"></div>
    <img src={hod.photo} alt={hod.name} class="aspect-[4/5] h-full w-full object-cover object-top md:aspect-auto" />
    <div class="absolute inset-x-0 bottom-0 photo-overlay p-5 pt-16 text-white">
      <span class="badge badge-primary badge-sm font-semibold">Head of Department</span>
    </div>
  </figure>

  <div class="card-body gap-4 p-6 md:p-8">
    <div>
      <h3 class="font-display text-2xl font-bold md:text-3xl">{hod.name}</h3>
      <p class="mt-1 font-medium text-primary">{hod.designation}</p>
    </div>

    {hod.education.length > 0 && (
      <ul class="space-y-1.5 text-sm text-base-content/80">
        {hod.education.map((e) => (
          <li class="flex gap-2"><Icon name="lucide:graduation-cap" class="mt-0.5 size-4 shrink-0 text-secondary" />{e}</li>
        ))}
      </ul>
    )}

    <div>
      <h4 class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-base-content/60">Research focus</h4>
      <div class="flex flex-wrap gap-1.5">
        {hod.keywords.map((k) => <span class="badge badge-soft badge-primary h-auto py-0.5">{k}</span>)}
      </div>
      <div class="mt-3 space-y-2 text-sm leading-relaxed text-base-content/75">
        {hod.interests.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <ul class="flex flex-wrap gap-x-6 gap-y-1.5 text-sm text-base-content/75">
      {hod.room && <li class="flex gap-2"><Icon name="lucide:map-pin" class="mt-0.5 size-4 shrink-0" />{hod.room}</li>}
      {hod.email && <li class="flex gap-2"><Icon name="lucide:mail" class="mt-0.5 size-4 shrink-0" /><a class="link-hover break-all" href={`mailto:${hod.email}`}>{hod.email}</a></li>}
      {hod.phone && <li class="flex gap-2"><Icon name="lucide:phone" class="mt-0.5 size-4 shrink-0" /><a class="link-hover" href={`tel:${hod.phone}`}>{hod.phone}</a></li>}
    </ul>

    <div class="card-actions mt-1 items-center">
      <a href={hod.profile} class="btn btn-primary">
        View profile <Icon name="lucide:arrow-right" class="size-4" />
      </a>
      {links.map((l) => (
        <a href={l.href} target="_blank" rel="noopener" class="btn btn-ghost btn-sm border-base-content/15">
          <Icon name={l.icon} class="size-4" />{l.label}
        </a>
      ))}
    </div>
  </div>
</article>
