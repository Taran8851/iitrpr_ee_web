---
/**
 * One publication category as a daisyUI collapse (<details>, so it works without JS and
 * can be opened by anchor). Journal/conference lists get a search box (site.ts filtering).
 */
import { Icon } from "astro-icon/components";
import SearchInput from "../ui/SearchInput.astro";
import EmptyState from "../ui/EmptyState.astro";
import type { Publication, BookOrPatent } from "./types";

interface Props {
  id: string;
  title: string;
  icon: string;
  pubs?: Publication[];
  books?: BookOrPatent[];
  open?: boolean;
}
const { id, title, icon, pubs = [], books = [], open = false } = Astro.props;
const count = pubs.length + books.length;
const searchable = pubs.length > 8;
const meta = (p: Publication) =>
  [p.volume && `Vol. ${p.volume}`, p.pages && `pp. ${p.pages}`].filter(Boolean).join(", ");
---
<details id={id} open={open} class="collapse collapse-arrow scroll-mt-36 rounded-2xl border border-base-content/10 bg-base-100 shadow-sm">
  <summary class="collapse-title flex items-center gap-3 font-semibold">
    <Icon name={icon} class="size-5 shrink-0 text-primary" />
    <span class="grow">{title}</span>
    <span class="badge badge-primary badge-soft">{count}</span>
  </summary>
  <div class="collapse-content">
    <div data-filter-root={searchable ? "" : undefined}>
      {searchable && (
        <div class="mb-4 flex flex-wrap items-center gap-3">
          <SearchInput placeholder={`Search ${title.toLowerCase()}…`} />
          <p class="text-sm text-base-content/60"><span data-filter-count>{count}</span> of {count}</p>
        </div>
      )}
      <ol class="space-y-3">
        {pubs.map((p, i) => (
          <li data-filter-item class="flex gap-3 rounded-xl border border-base-content/5 bg-base-200/50 p-4">
            <span class="font-display text-sm font-semibold text-primary tabular-nums">{i + 1}.</span>
            <div class="min-w-0 space-y-1 text-sm">
              <p class="font-semibold leading-snug">
                {p.url ? (
                  <a href={p.url} target="_blank" rel="noopener" class="link-hover hover:text-primary">
                    {p.title}<Icon name="lucide:external-link" class="ml-1 inline size-3.5 opacity-60" />
                  </a>
                ) : p.title}
              </p>
              {p.authors && <p class="text-base-content/70">{p.authors}</p>}
              <p class="text-base-content/70">
                {p.venue && <em>{p.venue}</em>}{p.venue && meta(p) && ", "}{meta(p)}
                {p.year && <span class="badge badge-ghost badge-sm ml-2 align-middle">{p.year}</span>}
              </p>
            </div>
          </li>
        ))}
        {books.map((b, i) => (
          <li class="flex gap-3 rounded-xl border border-base-content/5 bg-base-200/50 p-4">
            <span class="font-display text-sm font-semibold text-primary tabular-nums">{i + 1}.</span>
            <div class="min-w-0 space-y-1 text-sm">
              <p class="font-semibold leading-snug">{b.title}</p>
              {b.authors && <p class="text-base-content/70">{b.authors}</p>}
              <p class="text-base-content/70">
                {[b.publisher, b.isbn && `ISBN ${b.isbn}`].filter(Boolean).join(" · ")}
                {b.year && <span class="badge badge-ghost badge-sm ml-2 align-middle">{b.year}</span>}
              </p>
            </div>
          </li>
        ))}
      </ol>
      {searchable && <div class="mt-3"><EmptyState filter message="No publications match your search." /></div>}
    </div>
  </div>
</details>
