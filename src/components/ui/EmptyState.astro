---
/** "No results" message. `filter` = hidden until site.ts filtering finds nothing. */
import { Icon } from "astro-icon/components";
interface Props { message?: string; filter?: boolean }
const { message = "No results found.", filter = false } = Astro.props;
---
<div data-filter-empty={filter ? "" : undefined} hidden={filter} class="rounded-2xl border border-dashed border-base-content/20 p-10 text-center text-base-content/60">
  <Icon name="lucide:search-x" class="mx-auto mb-2 size-8" />
  <p>{message}</p>
</div>
