---
/** Decorative circuit-trace pattern. Absolutely positioned; parent needs `relative isolate overflow-hidden`. */
interface Props { class?: string; animated?: boolean }
const { class: cls = "opacity-10", animated = false } = Astro.props;
const id = `circuit-${Math.random().toString(36).slice(2, 8)}`;
---
<svg aria-hidden="true" class:list={["pointer-events-none absolute inset-0 -z-10 h-full w-full text-current", cls]}>
  <defs>
    <pattern id={id} width="160" height="160" patternUnits="userSpaceOnUse">
      <g fill="none" stroke="currentColor" stroke-width="1.2" class:list={[animated && "current-flow"]}>
        <path d="M0 40h50l20 20h40l10-10h40" />
        <path d="M40 160v-40l20-20v-30" />
        <path d="M110 0v30l20 20v40l-20 20v50" />
        <path d="M0 120h30l15-15h35" />
      </g>
      <g fill="currentColor">
        <circle cx="50" cy="40" r="2.5" /><circle cx="110" cy="60" r="2.5" /><circle cx="60" cy="70" r="2.5" />
        <circle cx="130" cy="90" r="2.5" /><circle cx="80" cy="105" r="2.5" /><rect x="146" y="46" width="8" height="8" rx="1" />
      </g>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`} />
</svg>
