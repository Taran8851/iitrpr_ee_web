---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Section from "../components/ui/Section.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import GlassCard from "../components/ui/GlassCard.astro";
import GlowBlobs from "../components/ui/GlowBlobs.astro";
import CircuitBg from "../components/ui/CircuitBg.astro";
import { Icon } from "astro-icon/components";
import data from "../data/academics/admissions.json";

const { intro, fallback, programs } = data;
---

<BaseLayout
  title="Admissions"
  description="Admission routes to B.Tech, M.Tech, M.S. and Ph.D. programmes in Electrical Engineering at IIT Ropar."
>
  <PageHero title="Admissions" eyebrow="Academics" lead="Criteria & eligibility for our programmes." crumbs={[{ label: "Academics" }]} />

  <Section>
    <GlowBlobs />
    <SectionHeading eyebrow="Programmes" title="Join Electrical Engineering at IIT Ropar" lead={intro} />
    <div class="grid gap-6 md:grid-cols-2">
      {programs.map((p) => (
        <GlassCard class="flex flex-col">
          <div class="mb-4 flex items-center gap-3">
            <span class="grid size-12 place-items-center rounded-xl bg-primary/15 text-primary">
              <Icon name={p.icon} class="size-6" />
            </span>
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest text-primary">{p.short}</p>
              <h2 class="text-xl font-bold leading-tight">{p.program}</h2>
            </div>
          </div>
          <p class="grow text-base-content/75">{p.text || fallback.text}</p>
          <div class="mt-5 flex flex-wrap gap-2">
            {!p.text && (
              <a href={fallback.href} target="_blank" rel="noopener" class="btn btn-primary btn-sm">
                {fallback.label}<Icon name="lucide:external-link" class="size-4" />
              </a>
            )}
            {p.links.map((l, i) => (
              <a href={l.href} target="_blank" rel="noopener" class:list={["btn btn-sm", p.text && i === 0 ? "btn-primary" : "btn-outline"]}>
                {l.label}<Icon name="lucide:external-link" class="size-4" />
              </a>
            ))}
          </div>
        </GlassCard>
      ))}
    </div>
  </Section>

  <section class="relative isolate overflow-hidden bg-[#0b1629] text-white">
    <CircuitBg class="text-cyan-300 opacity-[0.08]" animated />
    <div class="mx-auto flex max-w-7xl flex-col items-start gap-6 px-4 py-14 md:flex-row md:items-center md:justify-between">
      <div data-aos="fade-up">
        <h2 class="text-2xl font-bold md:text-3xl">Explore what you'll study</h2>
        <p class="mt-2 max-w-xl text-white/75">Browse the full course catalogue, or reach out to the department office with your questions.</p>
      </div>
      <div class="flex flex-wrap gap-3" data-aos="fade-up">
        <a href="/course" class="btn btn-primary">Course catalogue<Icon name="lucide:arrow-right" class="size-4" /></a>
        <a href="/contact" class="btn btn-outline border-white/40 text-white hover:bg-white hover:text-[#0b1629]">Contact us</a>
      </div>
    </div>
  </section>
</BaseLayout>
