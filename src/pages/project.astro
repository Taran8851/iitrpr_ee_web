---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Section from "../components/ui/Section.astro";
import StatCard from "../components/ui/StatCard.astro";
import SearchInput from "../components/ui/SearchInput.astro";
import EmptyState from "../components/ui/EmptyState.astro";
import ProjectRow from "../components/research-output/ProjectRow.astro";
import projects from "../data/research-output/projects.json";

const agencies = new Set(projects.map((p) => p.agency).filter(Boolean));
const eeFaculty = new Set(projects.flatMap((p) => p.faculty.filter((f) => f.slug).map((f) => f.slug)));
const groupCounts = new Map<string, number>();
for (const p of projects) groupCounts.set(p.agencyGroup, (groupCounts.get(p.agencyGroup) ?? 0) + 1);
const groups = [...groupCounts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BaseLayout title="Research Projects" description="Sponsored research and consultancy projects of the Department of Electrical Engineering, IIT Ropar.">
  <PageHero
    title="Research Projects"
    eyebrow="Research"
    crumbs={[{ label: "Research" }]}
    lead="Sponsored research and industry projects led by our faculty — funded by national agencies, international partners and industry."
  >
    <div class="mt-10 grid max-w-3xl grid-cols-1 gap-4 sm:grid-cols-3">
      <StatCard dark value={projects.length} label="Projects" icon="lucide:folder-kanban" />
      <StatCard dark value={agencies.size} label="Funding agencies" icon="lucide:landmark" />
      <StatCard dark value={eeFaculty.size} label="EE faculty involved" icon="lucide:users" />
    </div>
  </PageHero>

  <Section>
    <div data-filter-root>
      <div class="mb-6 flex flex-col gap-3 md:flex-row md:items-center">
        <SearchInput placeholder="Search projects, faculty, agencies…" />
        <label class="select select-bordered w-full md:max-w-xs">
          <span class="sr-only">Funding agency</span>
          <select data-filter-select="agency" autocomplete="off" aria-label="Filter by funding agency">
            <option value="all">All funding agencies</option>
            {groups.map(([g, n]) => <option value={g}>{g} ({n})</option>)}
          </select>
        </label>
        <p class="text-sm text-base-content/70 md:ml-auto" aria-live="polite">
          Showing <span data-filter-count class="font-semibold text-base-content">{projects.length}</span> of {projects.length}
        </p>
      </div>

      <div class="md:overflow-hidden md:rounded-2xl md:border md:border-base-content/10 md:bg-base-100">
        <div class="hidden grid-cols-[3rem_minmax(0,1fr)_14rem_14rem] gap-6 border-b border-base-content/10 bg-base-200 px-4 py-3 text-xs font-semibold uppercase tracking-wide text-base-content/60 md:grid" aria-hidden="true">
          <span>#</span><span>Project title</span><span>Funding agency</span><span>Faculty</span>
        </div>
        <ol class="grid gap-4 md:block">
          {projects.map((p, i) => <ProjectRow index={i + 1} {...p} />)}
        </ol>
      </div>
      <div class="mt-6"><EmptyState filter message="No projects match your search." /></div>
    </div>
    <p class="mt-8 text-sm text-base-content/60">
      Looking for outcomes? Browse the department's <a href="/publications" class="link link-primary">publications</a>.
    </p>
  </Section>
</BaseLayout>
