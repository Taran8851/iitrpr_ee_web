---
/**
 * Layout for every rebuilt page. Loads Tailwind/daisyUI, fonts, the glass header,
 * footer and the single site script (theme, AOS, GLightbox, filters, count-up).
 */
import "@fontsource-variable/noto-sans";
import "@fontsource-variable/space-grotesk";
import "../styles/global.css";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";

interface Props {
  title: string;
  description?: string;
  /** Let the page's hero sit under the transparent header (home page). */
  overlayHeader?: boolean;
}

const {
  title,
  description = "Department of Electrical Engineering, IIT Ropar — research, faculty, academics, news and placements.",
  overlayHeader = false,
} = Astro.props;
const fullTitle = title ? `${title} | EE · IIT Ropar` : "Department of Electrical Engineering | IIT Ropar";
---

<!doctype html>
<html lang="en" data-theme="voltage">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <script is:inline>
      // Apply saved / system theme before paint to avoid a flash.
      (() => {
        let t = null;
        try { t = localStorage.getItem("theme"); } catch {}
        if (!t) t = matchMedia("(prefers-color-scheme: dark)").matches ? "voltage-dark" : "voltage";
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] btn btn-primary btn-sm">
      Skip to main content
    </a>
    <Header overlay={overlayHeader} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
